# Keys for `pnpm read`. Copy this file to .env and fill in the ones you use.
# These names are not the ones Claude Code reads, so a session next to a run stays on the subscription.

# OpenAI. The reader uses this for openai: models (the default is openai:gpt-6-sol).
IMENNYK_OPENAI_KEY=

# Anthropic, for anthropic: models.
IMENNYK_ANTHROPIC_KEY=

# A Google Drive folder (--from drive:…).
IMENNYK_GOOGLE_CLIENT_ID=
IMENNYK_GOOGLE_CLIENT_SECRET=
IMENNYK_GOOGLE_REFRESH_TOKEN=

# A site that asks for a password when the scans come from a browser page.
IMENNYK_SITE_USER=
IMENNYK_SITE_PASSWORD=

# Where Chromium listens, and which binary to start when nothing is listening.
# IMENNYK_BROWSER=http://127.0.0.1:9222
# IMENNYK_CHROMIUM=chromium
